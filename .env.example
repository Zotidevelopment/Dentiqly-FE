# URL del backend. En producción (Vercel) apunta a https://dentiqly-be.vercel.app/api
VITE_API_URL=http://localhost:3000/api

# --- Medición ---
# GA4. Dejar vacío SOLO si algún día se configura la etiqueta de GA4 dentro de
# GTM; si no, los eventos se contarían dos veces.
VITE_GA4_ID=G-7FTCE52704

# Pixel de Meta (Instagram/Facebook Ads). Se saca de Meta Events Manager:
# Administrador de eventos -> Orígenes de datos -> tu pixel -> ID (~15 dígitos).
# Sin esto, las campañas de Instagram solo ven el clic: no pueden optimizar
# hacia registros ni armar públicos de retargeting.
VITE_META_PIXEL_ID=
